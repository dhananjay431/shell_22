   "Filter":{
      "dueFilters":[
         {
            "name":"Over Due",
            "TaskIdentifier": "TaskIdentifier:BB975EEF-B5A4-A1EB-9BE0-49FB5859B83D",
            "filtercondition":[
               {
                  "LT":{
                     "@field":"TaskIdentifier.SLA_OverDue",
                     "Value":""
                  }
               }
            ],
            "countIdentifier":"OVER_DUE"
         },
         {
            "name":"No Due",
            "TaskIdentifier": "TaskIdentifier:BB975EEF-B5A4-A1EB-9BE0-49FB5859B83D",
            "filtercondition":[
             {
                "Or":
                { "GE":{
                    "@field": "TaskIdentifier.SLA_NearingDue",
                    "Value":""
                  },
                  "And":{
                      "IsNotNull": {
                        "@field": "TaskIdentifier.SLA_NoDue"
                      },
                      "IsNull": [
                        {
                          "@field": "TaskIdentifier.SLA_NearingDue"
                        },{
                          "@field": "TaskIdentifier.SLA_Due"
                        },
                        {
                          "@field": "TaskIdentifier.SLA_OverDue"                        
                        }
                      ]
                  }
                }
              }
            ],
            "countIdentifier":"NO_DUE"
         },
         {
            "name":"Nearing Due",
            "TaskIdentifier": "TaskIdentifier:BB975EEF-B5A4-A1EB-9BE0-49FB5859B83D",
            "filtercondition":[
               {
                  "LT":{
                     "@field": "TaskIdentifier.SLA_NearingDue",
                     "Value":""
                  }
               },
               {
                  "GE":{
                     "@field": "TaskIdentifier.SLA_Due",
                     "Value":""
                  }
               }
            ],
            "countIdentifier":"NEAR_DUE"
          },
          {
            "name":"Due",
            "TaskIdentifier": "TaskIdentifier:BB975EEF-B5A4-A1EB-9BE0-49FB5859B83D",
            "filtercondition":[
               {
                  "LT":{
                     "@field": "TaskIdentifier.SLA_Due",
                     "Value":""
                  }
               },
               {
                  "GE":{
                     "@field": "TaskIdentifier.SLA_OverDue",
                     "Value":""
                  }
               }
            ],
            "countIdentifier":"DUE"
          }
      ],
      "status": {
        "TaskIdentifier": "TaskIdentifier:BB975EEF-B5A4-A1EB-9BE0-49FB5859B83D",
